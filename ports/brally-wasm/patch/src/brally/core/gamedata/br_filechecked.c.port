# Port deviations for src/brally/core/gamedata/br_filechecked.c -- see ports/brally-wasm/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:_CRTIMP
@drop define:BrFileWriteChecked
@drop undef:BrFileWriteChecked
@drop proto:BrLogFatalPrintf
@drop proto:_errno
@drop fn:BrFileCreateChecked
@drop fn:BrFileOpenChecked
@drop fn:BrFileReadChecked
@drop fn:BrFileWriteChecked
@after fn:BrFileWriteChecked

void BrFileWriteChecked(FILE *pFile, const void *pvData, uint32_t cbData)
{
    if (fwrite(pvData, 1, cbData, pFile) != (size_t)cbData)
        BrErrorf("File read failure");   /* sic -- this is an fwrite */
}
@end
