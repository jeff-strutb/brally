# Port deviations for src/core/driving/br_ctlai.c -- see ports/macos/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop proto:BrAiScanCorridor
@drop define:BR_AI_SCAN
@after define:BR_AI_SCAN

uint32_t BrAiScanCorridor(BrAiCar *pCar, int32_t a, uint32_t idx,
                          BrAiPathNode *pNode);
#define BR_AI_SCAN(pCar, a, idx, node) \
    BrAiScanCorridor((pCar), (a), (idx).v, (node).p)
@end
@drop fn:BrAiScanCorridor
