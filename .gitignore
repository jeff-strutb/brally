.DS_Store

# Python tooling environment
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# GAME DATA AND ORIGINAL BINARIES ARE DELIBERATELY NOT TRACKED.
#
# This repository holds only our own source: the portable C port, the analysis
# tooling, and generated metadata. Everything below is copyrighted Boss Rally
# material that each developer must supply from their own retail copy.
#
# NOTE: git does NOT support trailing comments on a pattern line. Keep every
# comment on its own line -- an earlier version of this file put them inline
# and the patterns silently did not match.
# ---------------------------------------------------------------------------

# pristine originals: retail CD image and N64 ROM
reference/

# BRD3D.dll, BRGlide.dll, Boot.exe, BossRally.exe
orig/

# BossRally.pod, *.rca, *.img, *.ci4/.lut4 taken from the disc
testdata/

# assets extracted from the N64 ROM (art, XM music)
extracted/

# disassembly generated from BRD3D.dll
asm/

# generated disassembly packets
work/

*.z64
*.BIN
*.bin
*.cue
*.dll
*.exe
*.pod
*.rca
*.img
*.xm
tools/msvc5/
tools/msvc42/
tools/wine/
reference/msvc/_extract/

# Scratch files -- anything named temp*
temp*
