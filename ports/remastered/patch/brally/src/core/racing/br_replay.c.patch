+/* Top Gear Rally Remastered: the races run at 60 ticks a second (rm_tick.h).
+ * A recording made in this run has a frame a tick; one read from a file made
+ * by the game (the CD's intro, credits and ending, a ghost saved by the PC
+ * game: their magic "RGho") has one every 30th of a second.  Such a slot is
+ * played a half frame a tick: s_half says the slot stands halfway to its next
+ * frame, shown as the two frames' blend (BrCarStateLerp, as the network's
+ * cars are), and its speed is taken at its own rate. */
+static int s_slotHz[BR_REPLAY_PLAYERS];   /* 0: the simulation's rate */
+static int s_half[BR_REPLAY_PLAYERS];
+
+void rm_replay_slot_hz(int slot, int hz)
+{
+    if (slot >= 0 && slot < BR_REPLAY_PLAYERS) {
+        s_slotHz[slot] = hz == rm_tick_hz() ? 0 : hz;
+        s_half[slot] = 0;
+    }
+}
+
+static int slot_halves(int i) { return s_slotHz[i] != 0 && s_slotHz[i] * 2 == rm_tick_hz(); }
+
+/* the slot's cursor moved by `step` of the simulation's ticks */
+static void slot_step(int i, int32_t step)
+{
+    if (slot_halves(i)) {
+        int32_t p = g_BrReplayCursor[i] * 2 + s_half[i] + step;
+        if (p < 0)
+            p = 0;
+        g_BrReplayCursor[i] = p >> 1;
+        s_half[i] = p & 1;
+    } else {
+        g_BrReplayCursor[i] += step;
+    }
+}
+
+/* frames a second of the slot's recording */
+static float slot_rate(int i) { return s_slotHz[i] ? (float)s_slotHz[i] : (float)rm_tick_hz(); }
+
