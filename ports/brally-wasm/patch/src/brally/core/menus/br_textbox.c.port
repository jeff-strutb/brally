# Port deviations for src/brally/core/menus/br_textbox.c -- see ports/brally-wasm/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:_CRTIMP
@drop define:BrTextBoxDeleteDtor
@drop define:BrTextBoxMeasureA
@drop define:BrTextBoxMeasureB
@drop define:BrTextBoxInit
@drop undef:BrTextBoxInit
@drop undef:BrTextBoxDeleteDtor
@drop undef:BrTextBoxMeasureA
@drop undef:BrTextBoxMeasureB
@drop var:DAT_100776f0
@drop fn:BrTextBoxInit
@drop type:BrTextBoxDeleteFlags
@drop fn:BrTextBoxDeleteDtor
@drop type:BrGlyphMetric12
@drop var:g_BrGlyphFontA12
@drop var:g_BrGlyphFontB12
