# Port deviations for src/core/net/br_dplaysession.c -- see ports/macos/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:_CRTIMP
@drop var:g_brUinAA2880
@drop define:BR73_NAA2880
@drop var:g_brUiapJoinBlob
@drop define:BR73_APJOINBLOB
@drop fn:BrSub1003D030
@drop var:g_brAA287C
@drop var:g_aBrA9C0B8
@drop fn:BrSub1003CFC0
@drop include:<windows.h>
@drop var:DAT_10ac315c
@drop fn:BrGlobalFreeAll
@drop var:DAT_10078898
