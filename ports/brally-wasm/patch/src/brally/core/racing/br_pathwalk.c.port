# Port deviations for src/brally/core/racing/br_pathwalk.c -- see ports/brally-wasm/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:BrCarInitTables
@drop define:BrCarClear29C8
@drop define:BrZeroRegions
@drop define:BrPathWalk
@drop undef:BrCarInitTables
@drop undef:BrCarClear29C8
@drop undef:BrZeroRegions
@drop undef:BrPathWalk
@drop proto:BrZeroRegions
@drop type:PwPoint
@drop type:PwNode
@drop type:PwSeg
@drop var:DAT_10af07f0
@drop var:DAT_106eed70
@drop var:DAT_10b1ce98
@drop var:DAT_10b1cbec
@drop fn:BrPathWalk
@drop type:RcPoint
@drop type:RcNode
@drop type:sizeof
