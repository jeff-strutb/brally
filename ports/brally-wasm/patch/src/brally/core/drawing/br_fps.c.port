# Port deviations for src/brally/core/drawing/br_fps.c -- see ports/brally-wasm/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:_CRTIMP
@drop fn:BrFpsReadout
@drop proto:FUN_1006e590
@drop fn:BrThunk11D10
@drop var:DAT_10396ef8
