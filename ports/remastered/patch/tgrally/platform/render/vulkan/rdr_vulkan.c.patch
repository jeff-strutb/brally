+}
+
+#ifdef __linux__
+/* Top Gear Rally Remastered on Linux: the window is another game's now, and a
+ * window has one swapchain at a time (Vulkan's rule, which macOS's shared
+ * layer and Windows' child window meet otherwise): this renderer's goes, made
+ * again on its next present in front (gfx/rcp.c's pictures between frames,
+ * which go on while the game waits; the present, whenever it is not in front) */
+void rdr_window_release(void)
+{
+    if (s_swap) {
+        vkDeviceWaitIdle(s_dev);
+        swap_destroy();
+    }
 }
+#else
+void rdr_window_release(void) {}
+#endif
 
