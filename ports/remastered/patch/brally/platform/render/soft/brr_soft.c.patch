+/* the Remastered textures (BR_FLAG_TEXTURES; light_surf.h): the draw's constants and entry, and the
+ * triangle being drawn in the world (its vertices, normal), set by brr_draw and tri */
+static struct {
+    int on, entry;
+    LightSurfU u;
+    const brr_vertex *v[3];
+    float n[3];
+} s_surf;
+
+/* the world point at pixel centre (px, py) of the triangle s_surf.v (perspective-correct, as s and t) */
+static void surf_world(float px, float py, float area_inv, float p[3])
+{
+    const brr_vertex *a = s_surf.v[0], *b = s_surf.v[1], *c = s_surf.v[2];
+    float w0 = ((c->x - b->x) * (py - b->y) - (c->y - b->y) * (px - b->x)) * area_inv;
+    float w1 = ((a->x - c->x) * (py - c->y) - (a->y - c->y) * (px - c->x)) * area_inv;
+    float w2 = ((b->x - a->x) * (py - a->y) - (b->y - a->y) * (px - a->x)) * area_inv;
+    float oow = a->oow * w0 + b->oow * w1 + c->oow * w2;
+    if (oow == 0) {
+        p[0] = a->wx * w0 + b->wx * w1 + c->wx * w2;
+        p[1] = a->wy * w0 + b->wy * w1 + c->wy * w2;
+        p[2] = a->wz * w0 + b->wz * w1 + c->wz * w2;
+        return;
+    }
+    p[0] = (a->wx * a->oow * w0 + b->wx * b->oow * w1 + c->wx * c->oow * w2) / oow;
+    p[1] = (a->wy * a->oow * w0 + b->wy * b->oow * w1 + c->wy * c->oow * w2) / oow;
+    p[2] = (a->wz * a->oow * w0 + b->wz * b->oow * w1 + c->wz * c->oow * w2) / oow;
+}
