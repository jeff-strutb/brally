+/* Top Gear Rally Remastered: the second player's port, from the app's controls
+ * (ports/remastered/platform/controls.h): the keys held and the host's second pad */
+void rm_player_menu(int player, const unsigned char *dik, const host_pad *pad, unsigned short *buttons,
+                    int *sx, int *sy);
+static unsigned char s_dik[256];        /* scan codes held (tgr_input_scan) */
+
+const unsigned char *tgr_input_dik(void) { return s_dik; }
+
+void tgr_input_scan(int scan, int down)
+{
+    if (scan > 0 && scan < 256)
+        s_dik[scan] = down != 0;
+}
+
+/* a second player can play: a keyboard (any desktop), or a second pad */
+static int two_players(void)
+{
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    host_pad p;
+    return host_pad_read_n(1, &p);
+#else
+    return 1;
+#endif
+}
 
