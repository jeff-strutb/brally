# Port deviations for src/core/menus/br_phasehook.c -- see ports/macos/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:BrPhaseHook_100450C0
@drop define:BrPhaseLeave_10044B40
@drop define:BrPhaseLeave_10044C70
@drop define:BrPhaseLeave_10044DE0
@drop define:BrPhaseLeave_10044F00
