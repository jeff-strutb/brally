+/* Top Gear Rally Remastered's Show FPS (its Remaster Options,
+ * ports/remastered/platform/options.c): the frames this game showed in the
+ * last second, at the bottom centre of its picture, over everything; the text
+ * state as the game left it */
+int rm_option(int which);               /* the app's (options.h: RM_OPT_FPS 2) */
+uint64_t host_ticks_ns(void);
+void BrTextHighlightOff(void);
+void BrTextAlignCentre(void);
+void BrTextSetFont(int font);
+void BrTextPrint(char *s, int x, int y);
+extern int D_8028BDC0, D_8028BDC4, D_8028BDC8, D_8028BDCC, D_8028BDD0, D_8028BDD4, D_8028BDD8,
+    D_8028BDDC, D_8028BDE0, D_8028BDE4, D_803519D8;
+extern uint32_t tgr_tween_presents;     /* the pictures shown (platform/gfx/rcp.c) */
+static void rm_fps(void)
+{
+  static uint64_t t0;
+  static uint32_t p0;
+  static int n, fps = -1;
+  uint64_t now = host_ticks_ns();
+  int sv[11];
+  char buf[24];
+  if (!t0)
+    t0 = now;
+  n++;
+  if (now - t0 >= 1000000000ull) {
+    if (tgr_tween_presents != p0) {    /* the pictures the screen took, drawn between frames too */
+      n = (int)(tgr_tween_presents - p0);
+    }
+    p0 = tgr_tween_presents;
+    fps = (int)(n * 1000000000ull / (now - t0) + 0.5);  /* (rounded) */
+    t0 = now;
+    n = 0;
+  }
+  if (fps < 0 || !rm_option(2))
+    return;
+  sv[0] = D_8028BDC0; sv[1] = D_8028BDC4; sv[2] = D_8028BDC8; sv[3] = D_8028BDCC; sv[4] = D_8028BDD0;
+  sv[5] = D_8028BDD4; sv[6] = D_8028BDD8; sv[7] = D_8028BDDC; sv[8] = D_8028BDE0; sv[9] = D_8028BDE4;
+  sv[10] = D_803519D8;
+  sprintf(buf, "%%ry%d FPS", fps);
+  gDPPipeSync(D_8028A858++);      /* the whole picture: a screen may have left a smaller scissor */
+  gDPSetScissor(D_8028A858++, G_SC_NON_INTERLACE, 0, 0, D_8028AAB0 << D_8028A850, D_8028AAB4 << D_8028A850);
+  D_8028BDCC = 0;                 /* the menu's colours, not a screen's own */
+  BrTextHighlightOff();
+  BrTextAlignCentre();
+  BrTextSetFont(11);
+  BrTextPrint(buf, D_8028AAB0 / 2, D_8028AAB4 - 1);   /* under the menus' button prompts */
+  D_8028BDC0 = sv[0]; D_8028BDC4 = sv[1]; D_8028BDC8 = sv[2]; D_8028BDCC = sv[3]; D_8028BDD0 = sv[4];
+  D_8028BDD4 = sv[5]; D_8028BDD8 = sv[6]; D_8028BDDC = sv[7]; D_8028BDE0 = sv[8]; D_8028BDE4 = sv[9];
+  D_803519D8 = sv[10];
+}
