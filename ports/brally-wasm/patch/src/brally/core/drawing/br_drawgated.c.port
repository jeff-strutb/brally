# Port deviations for src/brally/core/drawing/br_drawgated.c -- see ports/brally-wasm/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:BrPtrListContains
@drop define:_CRTIMP
@drop var:DAT_106e7710
@drop define:S17_PGFX
@drop var:DAT_105ccb58
