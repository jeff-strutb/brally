# Port deviations for src/core/scene/br_entpos.c -- see ports/macos/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:BrEntSetPos
@drop undef:BrEntSetPos
@drop type:BrEntSetPosArgs
@drop fn:BrEntSetPos
@after fn:BrEntSetPos

/* 0x10076420 */
/* WHAT IT DOES: move an entity to a position, writing the same three
 * coordinates into all the places the entity keeps them -- its matrix, its
 * cached position and two more copies. They are kept in step here rather
 * than derived, so all of them must be written. */
/* @implements 0x10076420 d3d BrEntSetPos */
/* @n64 0x8021FE04 located */
void BrEntSetPos(BrEnt *pE, float x, float y, float z)
{
    /* Store order is the original's: mat0.m[3], f26C8, st, stB, stA. */
    pE->mat0.m[3][0] = x;
    pE->mat0.m[3][1] = y;
    pE->mat0.m[3][2] = z;

    pE->f26C8[0] = x;
    pE->f26C8[1] = y;
    pE->f26C8[2] = z;

    pE->st.pos.x = x;
    pE->st.pos.y = y;
    pE->st.pos.z = z;

    pE->stB.pos.x = x;
    pE->stB.pos.y = y;
    pE->stB.pos.z = z;

    pE->stA.pos.x = x;
    pE->stA.pos.y = y;
    pE->stA.pos.z = z;

    BrRbBuildMatrix(&pE->matrix, &pE->st);
}
@end
