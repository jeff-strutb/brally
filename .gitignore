# Build output: everything under build/ is generated (per game and platform:
# build/brally/..., build/tgrally/null-null/..., build/toolchains/...).
build/
*.o
*.dSYM/
.DS_Store

# Python tooling environment
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# GAME DATA AND ORIGINAL BINARIES ARE DELIBERATELY NOT TRACKED.
#
# This repository holds only our own source: the decompilations, the ports,
# the analysis tooling, and generated metadata. Copyrighted material (the
# retail disc and its binaries, the N64 ROM, compiler install media, other
# games used as idiom corpora) lives under reference/ and each developer
# supplies it from their own copies.
#
# NOTE: git does NOT support trailing comments on a pattern line. Keep every
# comment on its own line.
# ---------------------------------------------------------------------------
reference/

# assets extracted from the N64 ROM (art, XM music), disassembly packets
extracted/
asm/
work/

*.z64
*.BIN
*.bin
*.cue
*.dll
*.exe
*.pod
*.rca
*.img
*.xm

# Toolchains staged by setup.sh. Only our own files in them are tracked: the
# Wine launcher and the MSVC 5 compatibility headers. The compiler and the CRT
# source come from your own Visual C++ 5.0 disc and are never tracked.
tools/toolchains/*
!tools/toolchains/wine.sh
!tools/toolchains/msvc5-compat/

# The Remastered assets (sources, concepts, decimated and packed models,
# textures, audio) are large and stay out of git. Their recipes are tracked:
# scripts, notes, per-asset bake settings, manifests and generation prompts.
ports/common/**
!ports/common/**/
!ports/common/assets/**
!ports/common/**/*.py
!ports/common/**/*.sh
!ports/common/**/*.md
!ports/common/**/bake.json
!ports/common/**/manifest.json
!ports/common/**/remastered.json
!ports/common/**/prompts/*.txt
!ports/common/**/prompts/*.json

# Scratch files: anything named temp*
temp*

# MSVC incremental-build databases (the build keeps them under build/)
*.idb
*.pdb
!ports/common/**/candidates/*.json
