/* ================================================================== */
/* 3. Screen wipe / fade                                              */
/* ================================================================== */

/* 0x10017F10 (d3d 0x1002AEA0) */
int BrFadeRelease(BrFadeState *pSt)
{
    pSt->refCount -= 1;
    if (pSt->refCount == 0)
        pSt->pfnRelease();
    return 1;
}

/* 0x10017F30 (d3d 0x1002AEC0) */
/* @n64 0x8026B434 located */
void BrFadeLatch(BrFadeState *pSt)
{
    pSt->pos      = pSt->srcC0;
    pSt->f5754FC  = pSt->srcC4;
}
@end
