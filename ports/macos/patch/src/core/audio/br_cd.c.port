/* WHAT IT DOES: closes the EAR music channel if one is actually running. */
/* @implements 0x10002440 d3d BrCdMaybeClose */
int BrCdMaybeClose(void)
{
    if (g_0940A4 != 0) {
        if (g_220CD0 != 0) {
            if (g_220C3C != 0) {
