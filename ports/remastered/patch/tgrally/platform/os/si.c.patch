+/* Remastered: both Top Gear Rally libraries keep this pak (one file): before
+ * each use the notes are read again when the other has written it since this
+ * one last read or wrote it (the file, its size, its time) */
+static struct stat s_pak_seen;
+static int s_pak_seen_ok;
+
+static void pak_mark(void)
+{
+    s_pak_seen_ok = s_pak_path[0] && stat(s_pak_path, &s_pak_seen) == 0;
+}
+
+static void pak_fresh(void)
+{
+    struct stat st;
+    if (!s_pak_path[0] || stat(s_pak_path, &st) != 0)
+        return;
+    if (s_pak_seen_ok && st.st_ino == s_pak_seen.st_ino && st.st_size == s_pak_seen.st_size &&
+        st.st_mtime == s_pak_seen.st_mtime)
+        return;
+    pak_clear();
+    pak_load(s_pak_path);
+    pak_mark();
 }
 
