# Port deviations for src/core/drawing/br_font.c -- see ports/macos/tools/portgen.py.
# The decomp file is what MSVC compiles; these are the items the
# Mac port drops, and the port bodies it compiles in their place.
@drop define:_CRTIMP
@drop define:BrFontRegisterPages
@drop define:BrFontMeasure
@drop define:BrTextEmitString
@drop undef:BrFontRegisterPages
@drop undef:BrFontMeasure
@drop undef:BrTextEmitString
@drop proto:BrFontRegisterPages
