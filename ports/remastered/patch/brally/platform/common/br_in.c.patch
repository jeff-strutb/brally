--- a/platform/common/br_in.c
+++ b/platform/common/br_in.c
@@ -191,25 +191,40 @@
  * game exactly the step from its cursor to the pointer; then it stops, so a
  * still mouse reads as still (the race reads the mouse as an axis). The
  * wasm lane did the same (host_dx.c abs_step). */
+/* Top Gear Rally Remastered: the pointer's own movements and presses counted
+ * (rm_menuwide.c: the menus' keys take over from the pointer until it moves) */
+int plat_pointer_seq;
+
 void plat_mouse_abs(int x, int y)
 {
     s_ax = x;
     s_ay = y;
     s_alive = 30;
+    plat_pointer_seq++;
 }
 
 void plat_mouse_move(int dx, int dy)
 {
     s_mdx += dx;
     s_mdy += dy;
+    plat_pointer_seq++;
 }
 
 void plat_mouse_button(int down)
 {
     s_mbtn = down;
     s_mlatch |= down;
+    if (down)
+        plat_pointer_seq++;
 }
 
+/* the cursor no longer follows the pointer (the keys took over) */
+void plat_mouse_park(void)
+{
+    s_alive = 0;
+    s_mdx = s_mdy = 0;
+}
+
 /* the device now, in the block the game reads: the keyboard's 256 scan
  * codes, the mouse's movement and buttons (x y z, 4 buttons), the
  * joystick's axes, POVs at 0x20 and buttons at 0x30 */
