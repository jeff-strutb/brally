@drop include:"br_match.h"
@drop undef:BrPhaseHook_100450C0
@drop undef:BrPhaseLeave_10044B40
@drop undef:BrPhaseLeave_10044C70
@drop undef:BrPhaseLeave_10044DE0
@drop undef:BrPhaseLeave_10044F00
@drop undef:BrPhaseHook_10045050
@drop undef:BrPhaseHook_10045090
@drop undef:BrPhaseDispatch_100450F0
@drop var:g_br0AA010
@drop var:g_br0AC304
@drop var:g_brPhaseAA2904
@drop var:g_brAA2908
@drop var:g_brAA2940
@drop var:g_brAA295C
@drop var:g_brAA2964
@drop var:g_brAA2968
