+int tgr_tween_present(void);            /* Top Gear Rally Remastered: gfx/rcp.c */
+int tgr_tween_render_thread(void);
 
+/* Remastered: the thread that draws the game's frames, while it waits, puts
+   pictures between them on the screen (as often as the display takes one;
+   the renderer's present keeps the pace) and looks at its queue between
+   pictures; 1 if one went */
+static int tween_wait(void)
+{
+    static uint32_t checked, tries, went;
+    int drew;
+    if (!tgr_tween_render_thread())
+        return 0;
+    if (g_tgr.headless && getenv("RM_TWEEN_CHECK")) {   /* (a check: one try a retrace) */
+        if (checked == s_frame)
+            return 0;
+        checked = s_frame;
+    }
+    host_mutex_unlock(G);
+    tgr_gfx_lock();
+    drew = tgr_tween_present();
+    tgr_gfx_unlock();
+    host_mutex_lock(G);
+    if (g_tgr.headless && getenv("RM_TWEEN_CHECK")) {
+        tries++;
+        went += drew;
+        if (tries % 600 == 0)
+            fprintf(stderr, "TWEEN CHECK %u retraces, %u from the renderer's thread\n", tries, went);
+    }
+    return drew;
+}
